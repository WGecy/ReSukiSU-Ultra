+static bool pkg_vis_dir_is_android_data(struct dentry *dentry)
+{
+	struct dentry *parent;
+	struct qstr *name;
+
+	if (!dentry || !dentry->d_parent)
+		return false;
+	name = &dentry->d_name;
+	if (name->len != 4 || strncmp(name->name, "data", 4) != 0)
+		return false;
+	parent = dentry->d_parent;
+	if (!parent || !parent->d_name.name)
+		return false;
